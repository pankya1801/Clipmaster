{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Clipmaster",
  "version": "0.2.0",
  "identifier": "com.clipmaster.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      { "title": "Clipmaster", "width": 1440, "height": 900, "minWidth": 1024, "minHeight": 640 }
    ],
    "security": {
      "csp": null,
      "assetProtocol": { "enable": true, "scope": ["**"] }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.png", "icons/icon.ico", "icons/icon.icns"],
    "category": "Video",
    "resources": ["fonts/*"],
    "shortDescription": "Free, open-source video editor",
    "license": "MIT"
  }
}
